{
  "name": "stonyx",
  "version": "0.2.3-beta.23",
  "description": "Base stonyx framework module",
  "main": "main.js",
  "type": "module",
  "bin": {
    "stonyx": "./src/cli.js"
  },
  "exports": {
    ".": "./src/main.js",
    "./config": "./src/exports/config.js",
    "./log": "./src/exports/log.js",
    "./test-helpers": "./src/exports/test-helpers.js",
    "./lifecycle": "./src/lifecycle.js"
  },
  "scripts": {
    "start": "node .",
    "test": "qunit",
    "error": "echo \"Error: no error handling\" && exit 1",
    "postinstall": "node scripts/postinstall.js",
    "prepublishOnly": "npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abofs/stonyx.git"
  },
  "files": [
    "src",
    "config",
    "README.md"
  ],
  "publishConfig": {
    "provenance": true
  },
  "author": "Stone Costa",
  "license": "Apache-2.0",
  "contributors": [
    "Stone Costa <stone.costa@synamicd.com>"
  ],
  "bugs": {
    "url": "https://github.com/abofs/stonyx/issues"
  },
  "dependencies": {
    "@stonyx/utils": "0.2.3-beta.11",
    "@stonyx/logs": "1.0.1-beta.6"
  },
  "devDependencies": {
    "qunit": "^2.24.1",
    "sinon": "^21.0.0"
  }
}
