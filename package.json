{
  "name": "stonyx",
  "version": "0.2.3-beta.95",
  "description": "Base stonyx framework module",
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "type": "module",
  "bin": {
    "stonyx": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js"
    },
    "./config": {
      "types": "./dist/exports/config.d.ts",
      "default": "./dist/exports/config.js"
    },
    "./log": {
      "types": "./dist/exports/log.d.ts",
      "default": "./dist/exports/log.js"
    },
    "./test-helpers": {
      "types": "./dist/exports/test-helpers.d.ts",
      "default": "./dist/exports/test-helpers.js"
    },
    "./lifecycle": {
      "types": "./dist/lifecycle.d.ts",
      "default": "./dist/lifecycle.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "start": "node .",
    "test": "pnpm build && node --import tsx node_modules/qunit/bin/qunit.js 'test/**/*-test.ts'",
    "error": "echo \"Error: no error handling\" && exit 1",
    "postinstall": "node scripts/postinstall.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abofs/stonyx.git"
  },
  "files": [
    "dist",
    "config",
    "scripts",
    "README.md"
  ],
  "publishConfig": {
    "provenance": true
  },
  "author": "Stone Costa",
  "license": "Apache-2.0",
  "contributors": [
    "Stone Costa <stone.costa@synamicd.com>"
  ],
  "bugs": {
    "url": "https://github.com/abofs/stonyx/issues"
  },
  "dependencies": {
    "@stonyx/utils": "0.2.3-beta.27",
    "@stonyx/logs": "1.0.1-beta.21"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "@types/qunit": "^2.19.13",
    "@types/sinon": "^21.0.1",
    "qunit": "^2.24.1",
    "sinon": "^21.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3"
  }
}
